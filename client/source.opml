<?xml version="1.0" encoding="ISO-8859-1"?>
<opml version="2.0">
	<head>
		<title>scripts.js</title>
		<dateModified>Mon, 09 Feb 2026 15:40:12 GMT</dateModified>
		<expansionState></expansionState>
		<vertScrollState>1</vertScrollState>
		<windowTop>300</windowTop>
		<windowLeft>700</windowLeft>
		<windowBottom>900</windowBottom>
		<windowRight>1500</windowRight>
		</head>
	<body text="scripts.js">
		<outline text="var urlStats = &quot;//s3.amazonaws.com/scripting.com/code/servermonitor/stats.json&quot;; "></outline>
		<outline text="var urlServerList = &quot;//s3.amazonaws.com/scripting.com/code/servermonitor/serverlist.json&quot;; "></outline>
		<outline isComment="true" text="var urlStats = &quot;http://scripting.com/code/servermonitor/stats.json&quot;; "></outline>
		<outline isComment="true" text="var urlServerList = &quot;http://scripting.com/code/servermonitor/serverlist.json&quot;; "></outline>
		<outline text="var ctUpdates = 0;"></outline>
		<outline text="var stats = undefined;"></outline>
		<outline text="var urlServerStats = &quot;http://modena.scripting.com:1410/stats&quot;; //used to see if server is alive"></outline>
		<outline text="var flServerIsAlive = true;"></outline>
		<outline text=""></outline>
		<outline text="function setFlServerIsAlive () {">
			<outline text="readHttpFileThruProxy (urlServerStats, undefined, function (jsontext) {">
				<outline text="flServerIsAlive = jsontext !== undefined;"></outline>
				<outline text="});"></outline>
				</outline>
			<outline isComment="true" text="readHttpFile (urlServerStats, function (jsontext) {">
				<outline text="flServerIsAlive = jsontext !== undefined;"></outline>
				<outline text="});"></outline>
				</outline>
			<outline text="}"></outline>
			</outline>
		<outline text="function howLongString (when) {">
			<outline text="function firstPart (num) {">
				<outline text="return (stringNthField (num.toString (), &quot;.&quot;, 1));"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="var secs = firstPart (secondsSince (when));"></outline>
			<outline text="var minutes = firstPart (secs / 60);"></outline>
			<outline text="var hours = firstPart (minutes / 60);"></outline>
			<outline text="var days = firstPart (hours / 24);"></outline>
			<outline text=""></outline>
			<outline text="var s = secs + &quot; seconds&quot;;"></outline>
			<outline text="if (minutes &gt; 3) {">
				<outline text="s = minutes + &quot; minutes&quot;;"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="if (hours &gt; 3) {">
				<outline text="s = hours + &quot; hours&quot;;"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="if (days &gt; 2) {">
				<outline text="s = days + &quot; days&quot;"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="return (s);"></outline>
			<outline text="}"></outline>
			</outline>
		<outline text="function updateServerStatusMsg () {">
			<outline text="function msg (s) {">
				<outline text="if (s != $(&quot;#idServerStatusMsg&quot;).html ()) {">
					<outline text="$(&quot;#idServerStatusMsg&quot;).html (s);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="}"></outline>
				</outline>
			<outline text="if (flServerIsAlive) {">
				<outline text="if (stats !== undefined) {">
					<outline text="msg (&quot;Server has been been running for: &quot; + howLongString (stats.whenLastServerStart) + &quot;.&quot;);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="}"></outline>
				</outline>
			<outline text="else {">
				<outline text="msg (&quot;Server is not running.&quot;);"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="}"></outline>
			</outline>
		<outline text="function viewTable () {">
			<outline text="var htmltext = &quot;&quot;, indentlevel = 0, now = new Date ();"></outline>
			<outline text="function add (s) {">
				<outline text="htmltext +=  filledString (&quot;\t&quot;, indentlevel) + s + &quot;\n&quot;;"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="function viewTimeString (when, flbold) {">
				<outline text="if (when === &quot;1970-01-01T00:00:00.000Z&quot;) {">
					<outline text="return (&quot;&quot;);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="var s = getFacebookTimeString (when);"></outline>
				<outline text="if (s == &quot;Just now&quot;) {">
					<outline text="s = &quot;now&quot;;"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="if (flbold) {">
					<outline text="return (&quot;&lt;span class=\&quot;spBold\&quot;&gt;&quot; + s + &quot;&lt;/span&gt;&quot;);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="else {">
					<outline text="return (s);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="}"></outline>
				</outline>
			<outline text="function viewNumber (num, flbold) {">
				<outline text="num = Number (num);"></outline>
				<outline text="if (num == 0) {">
					<outline text="return (&quot;&quot;);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="else {">
					<outline text="if (flbold) {">
						<outline text="return (&quot;&lt;span class=\&quot;spBold\&quot;&gt;&quot; + num.toString () + &quot;&lt;/span&gt;&quot;);"></outline>
						<outline text="}"></outline>
						</outline>
					<outline text="else {">
						<outline text="return (num.toString ());"></outline>
						<outline text="}"></outline>
						</outline>
					<outline text="}"></outline>
					</outline>
				<outline text="}"></outline>
				</outline>
			<outline text="function formatDateTime (d) {">
				<outline text="d = new Date (d);"></outline>
				<outline isComment="true" text="return (dateFormat (d, &quot;m/d/yyyy; h:MM TT&quot;));"></outline>
				<outline isComment="true" text="return (dateFormat (d, &quot;dddd, mmmm dS, yyyy, h:MM:ss TT&quot;));"></outline>
				<outline text="return (d.toLocaleDateString () + &quot; at &quot; + d.toLocaleTimeString ());"></outline>
				<outline text="}"></outline>
				</outline>
			<outline text="console.log (&quot;\nviewTable: &quot; + now.toLocaleTimeString ());"></outline>
			<outline text="readHttpFile (urlServerList, function (jsontext) {">
				<outline text="var serverlist = JSON.parse (jsontext);"></outline>
				<outline text="function serverStillExists (name) {">
					<outline text="name = name.toLowerCase ();"></outline>
					<outline text="for (var x in serverlist.theMachines) {">
						<outline text="if (serverlist.theMachines [x].toLowerCase () == name) {">
							<outline text="return (true);"></outline>
							<outline text="}"></outline>
							</outline>
						<outline text="}"></outline>
						</outline>
					<outline text="return (false);"></outline>
					<outline text="}"></outline>
					</outline>
				<outline text="console.log (&quot;viewTable: serverlist == &quot; + jsonStringify (serverlist));"></outline>
				<outline text="readHttpFile (urlStats, function (jsontext) {">
					<outline text="stats = JSON.parse (jsontext);"></outline>
					<outline text="updateServerStatusMsg ();"></outline>
					<outline text="console.log (&quot;viewTable: stats == &quot; + jsonStringify (stats));"></outline>
					<outline text=""></outline>
					<outline text="function addServersTable () {">
						<outline text="add (&quot;&lt;table class=\&quot;table\&quot;&gt;&quot;); indentlevel++;"></outline>
						<outline text="//header">
							<outline text="add (&quot;&lt;tr&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Server&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Checks&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline isComment="true" text="add (&quot;&lt;td&gt;&lt;b&gt;When&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Errors&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline isComment="true" text="add (&quot;&lt;td&gt;&lt;b&gt;Last error&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;When&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Secs&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Machine&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;/tr&gt;&quot;);"></outline>
							</outline>
						<outline text=""></outline>
						<outline text="var nameArray = new Array ();"></outline>
						<outline text="for (var x in stats.servers) {">
							<outline text="nameArray.push (x);"></outline>
							<outline text="}"></outline>
							</outline>
						<outline text="nameArray.sort ();"></outline>
						<outline text="for (var i = 0; i &lt; nameArray.length; i++) {">
							<outline text="var x = nameArray [i];"></outline>
							<outline text="if (serverlist.theList [x] !== undefined) {">
								<outline text="var server = stats.servers [x], flbold = server.ctConsecutiveErrors &gt; 0;"></outline>
								<outline text="var url = serverlist.theList [x].url;"></outline>
								<outline text=""></outline>
								<outline text="add (&quot;&lt;tr&gt;&quot;); indentlevel++;"></outline>
								<outline text="add (&quot;&lt;td&gt;&lt;a href=\&quot;&quot; + url + &quot;\&quot; target=\&quot;_blank\&quot;&gt;&quot; + x + &quot;&lt;/a&gt;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (server.ctChecksToday) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline isComment="true" text="add (&quot;&lt;td&gt;&quot; + viewTimeString (server.whenLastCheck) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (server.ctErrorsToday, flbold) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text=""></outline>
								<outline text="//whenLastError">
									<outline text="if ((server.ctErrorsToday &gt; 0) &amp;&amp; (sameDay (server.whenLastError, now))) {">
										<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewTimeString (server.whenLastError, flbold) + &quot;&lt;/td&gt;&quot;); "></outline>
										<outline text="}"></outline>
										</outline>
									<outline text="else {">
										<outline text="add (&quot;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&quot;); "></outline>
										<outline text="}"></outline>
										</outline>
									</outline>
								<outline text=""></outline>
								<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (server.ctSecsLastCheck) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;td&gt;&quot; + server.serverName + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;/tr&gt;&quot;); indentlevel--;"></outline>
								<outline text="}"></outline>
								</outline>
							<outline text="}"></outline>
							</outline>
						<outline text=""></outline>
						<outline isComment="true" text="for (var x in stats.servers) {">
							<outline text="if (serverlist.theList [x] !== undefined) {">
								<outline text="var server = stats.servers [x], flbold = server.ctConsecutiveErrors &gt; 0;"></outline>
								<outline text="var url = serverlist.theList [x].url;"></outline>
								<outline text=""></outline>
								<outline text="add (&quot;&lt;tr&gt;&quot;); indentlevel++;"></outline>
								<outline text="add (&quot;&lt;td&gt;&lt;a href=\&quot;&quot; + url + &quot;\&quot; target=\&quot;_blank\&quot;&gt;&quot; + x + &quot;&lt;/a&gt;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (server.ctChecksToday) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline isComment="true" text="add (&quot;&lt;td&gt;&quot; + viewTimeString (server.whenLastCheck) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (server.ctErrorsToday, flbold) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text=""></outline>
								<outline text="//whenLastError">
									<outline text="if ((server.ctErrorsToday &gt; 0) &amp;&amp; (sameDay (server.whenLastError, now))) {">
										<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewTimeString (server.whenLastError, flbold) + &quot;&lt;/td&gt;&quot;); "></outline>
										<outline text="}"></outline>
										</outline>
									<outline text="else {">
										<outline text="add (&quot;&lt;td&gt;&amp;nbsp;&lt;/td&gt;&quot;); "></outline>
										<outline text="}"></outline>
										</outline>
									</outline>
								<outline text=""></outline>
								<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (server.ctSecsLastCheck) + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;td&gt;&quot; + server.serverName + &quot;&lt;/td&gt;&quot;); "></outline>
								<outline text="add (&quot;&lt;/tr&gt;&quot;); indentlevel--;"></outline>
								<outline text="}"></outline>
								</outline>
							<outline text="}"></outline>
							</outline>
						<outline text="add (&quot;&lt;/table&gt;&quot;); indentlevel--;"></outline>
						<outline text="}"></outline>
						</outline>
					<outline text="function addMachinesTable () {">
						<outline text="add (&quot;&lt;table class=\&quot;table machineTable\&quot;&gt;&quot;); indentlevel++;"></outline>
						<outline text="//header">
							<outline text="add (&quot;&lt;tr&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Machine&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;% free&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline isComment="true" text="add (&quot;&lt;td&gt;&lt;b&gt;Free space&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;Checks&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;td&gt;&lt;b&gt;When&lt;/b&gt;&lt;/td&gt;&quot;);"></outline>
							<outline text="add (&quot;&lt;/tr&gt;&quot;);"></outline>
							</outline>
						<outline text=""></outline>
						<outline text="var nameArray = new Array ();"></outline>
						<outline text="for (var x in stats.machines) {">
							<outline text="if (serverStillExists (x)) { //12/11/19 by DW">
								<outline text="nameArray.push (x);"></outline>
								<outline text="}"></outline>
								</outline>
							<outline text="}"></outline>
							</outline>
						<outline text="nameArray.sort ();"></outline>
						<outline text="for (var i = 0; i &lt; nameArray.length; i++) {">
							<outline text="var name = nameArray [i];"></outline>
							<outline text="var machine = stats.machines [name];"></outline>
							<outline text="add (&quot;&lt;tr&gt;&quot;); indentlevel++;"></outline>
							<outline text="add (&quot;&lt;td&gt;&quot; + name + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (machine.percent) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline isComment="true" text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + gigabyteString (machine.ctAvailable) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (machine.ctUpdates) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;td&gt;&quot; + viewTimeString (machine.whenLastUpdate) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;/tr&gt;&quot;); indentlevel--;"></outline>
							<outline text="}"></outline>
							</outline>
						<outline text=""></outline>
						<outline text=""></outline>
						<outline isComment="true" text="for (var x in stats.machines) {">
							<outline text="var machine = stats.machines [x];"></outline>
							<outline text="add (&quot;&lt;tr&gt;&quot;); indentlevel++;"></outline>
							<outline text="add (&quot;&lt;td&gt;&quot; + x + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (machine.percent, flbold) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;td class=\&quot;tdNum\&quot;&gt;&quot; + viewNumber (machine.ctUpdates) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;td&gt;&quot; + viewTimeString (machine.whenLastUpdate) + &quot;&lt;/td&gt;&quot;); "></outline>
							<outline text="add (&quot;&lt;/tr&gt;&quot;); indentlevel--;"></outline>
							<outline text="}"></outline>
							</outline>
						<outline text=""></outline>
						<outline text="add (&quot;&lt;/table&gt;&quot;); indentlevel--;"></outline>
						<outline text="}"></outline>
						</outline>
					<outline text=""></outline>
					<outline text="addMachinesTable (); //12/6/18 by DW"></outline>
					<outline text="addServersTable ();"></outline>
					<outline text=""></outline>
					<outline text="add (&quot;&lt;div class=\&quot;divLegend\&quot;&gt;&quot;); indentlevel++;"></outline>
					<outline text="add (&quot;&lt;p&gt;&lt;b&gt;&quot; + stats.productName + &quot; v&quot; + stats.version + &quot;&lt;/b&gt;.&lt;/p&gt;&quot;);"></outline>
					<outline text="add (&quot;&lt;p&gt;JSON file with &lt;a href=\&quot;&quot; + urlStats + &quot;\&quot; target=\&quot;_blank\&quot;&gt;stats&lt;/a&gt; and the &lt;a href=\&quot;&quot; + urlServerList + &quot;\&quot; target=\&quot;_blank\&quot;&gt;server list&lt;/a&gt;.&lt;/p&gt;&quot;);"></outline>
					<outline text="//servername -- 12/24/18 by DW">
						<outline text="var servername = serverlist.theMachines [stats.ipAddressServer]"></outline>
						<outline text="if (servername === undefined) {">
							<outline text="servername = stats.ipAddressServer;"></outline>
							<outline text="}"></outline>
							</outline>
						<outline text="add (&quot;&lt;p&gt;ServerMonitor is running on: &quot; + servername + &quot;.&lt;/p&gt;&quot;);"></outline>
						</outline>
					<outline text="add (&quot;&lt;p&gt;Server has been up since: &quot; + formatDateTime (stats.whenLastServerStart) + &quot;.&lt;/p&gt;&quot;);"></outline>
					<outline isComment="true" text="add (&quot;&lt;p&gt;Server has been been running for: &quot; + howLongString (stats.whenLastServerStart) + &quot;.&lt;/p&gt;&quot;);"></outline>
					<outline text="add (&quot;&lt;p&gt;Last update on server: &quot; + formatDateTime (stats.whenLastSave) + &quot;.&lt;/p&gt;&quot;);"></outline>
					<outline text="add (&quot;&lt;p&gt;Number of times this page has updated: &quot; + ++ctUpdates + &quot;.&lt;/p&gt;&quot;);"></outline>
					<outline text="add (&quot;&lt;/div&gt;&quot;); indentlevel--;"></outline>
					<outline text=""></outline>
					<outline text="$(&quot;#idServerMonitorTable&quot;).html (htmltext);"></outline>
					<outline isComment="true" text="$(&quot;#idServerMonitorTable&quot;).html (&quot;&lt;pre&gt;&quot; + jsonStringify (stats) + &quot;&lt;/pre&gt;&quot;);"></outline>
					<outline text="});"></outline>
					</outline>
				<outline text="});"></outline>
				</outline>
			<outline text="}"></outline>
			</outline>
		<outline text="function everyMinute () {">
			<outline text="viewTable ();"></outline>
			<outline text="setFlServerIsAlive ();"></outline>
			<outline text="}"></outline>
			</outline>
		<outline text="function everySecond () {">
			<outline text="updateServerStatusMsg ();"></outline>
			<outline text="}"></outline>
			</outline>
		<outline text="function startup () {">
			<outline text="console.log (&quot;startup&quot;);"></outline>
			<outline text="viewTable ();"></outline>
			<outline text="setFlServerIsAlive ();"></outline>
			<outline text="runEveryMinute (everyMinute);"></outline>
			<outline text="self.setInterval (everySecond, 1000); "></outline>
			<outline text="}"></outline>
			</outline>
		</body>
	</opml>
